{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Pilot Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "gpuorbit-pilot-health",
  "title": "GPUOrbit pilot health",
  "description": "Database connectivity, orchestrator readiness, and metrics collection for the pilot target.",
  "tags": ["gpuorbit", "pilot"],
  "schemaVersion": 39,
  "timezone": "browser",
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Postgres probe",
      "description": "A real database query from the orchestrator.",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "(marketplace_dependency_up{job=\"gpuorbit-orchestrator\", dependency=\"postgres\"} and on (job, instance) (up{job=\"gpuorbit-orchestrator\"} == 1)) or on () vector(-1)",
          "instant": true,
          "range": false
        }
      ],
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"-1": {"text": "Unknown", "color": "gray"}, "0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Orchestrator readiness",
      "description": "Ready when Postgres responds and the startup schema applied. Failed readiness with Postgres up points to schema initialization.",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "(marketplace_orchestrator_ready{job=\"gpuorbit-orchestrator\"} and on (job, instance) (up{job=\"gpuorbit-orchestrator\"} == 1)) or on () vector(-1)",
          "instant": true,
          "range": false
        }
      ],
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"-1": {"text": "Unknown", "color": "gray"}, "0": {"text": "Degraded", "color": "red"}, "1": {"text": "Ready", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Metrics collection",
      "description": "Current scrape state and whether both health gauges are present. Check Prometheus Targets when collection is unavailable.",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "((up{job=\"gpuorbit-orchestrator\"} == 1) and on (job, instance) marketplace_dependency_up{job=\"gpuorbit-orchestrator\", dependency=\"postgres\"} and on (job, instance) marketplace_orchestrator_ready{job=\"gpuorbit-orchestrator\"}) or on () vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Unavailable", "color": "red"}, "1": {"text": "Reporting", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Health history",
      "description": "Green indicates a healthy state, red indicates a failure, and gaps indicate missing samples.",
      "type": "state-timeline",
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "marketplace_dependency_up{job=\"gpuorbit-orchestrator\", dependency=\"postgres\"}", "legendFormat": "Postgres", "range": true},
        {"refId": "B", "expr": "marketplace_orchestrator_ready{job=\"gpuorbit-orchestrator\"}", "legendFormat": "Readiness", "range": true},
        {"refId": "C", "expr": "up{job=\"gpuorbit-orchestrator\"}", "legendFormat": "Scrape", "range": true}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed"},
          "mappings": [{"type": "value", "options": {"0": {"text": "Failed", "color": "red"}, "1": {"text": "Healthy", "color": "green"}}}],
          "custom": {"fillOpacity": 70, "lineWidth": 0, "spanNulls": false}
        }
      },
      "options": {"mergeValues": true, "rowHeight": 0.8, "showValue": "auto", "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ],
  "version": 1
}
