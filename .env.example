# ============================================================
# P2P Compute Marketplace — Environment Variables (Template)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. The real password must be set
# via your secret manager or local environment.
# ============================================================

# --- Database ---
POSTGRES_USER=marketplace
# REQUIRED: Set a strong password. Do NOT use the default below.
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
# Local dev URL (points to localhost; override for Docker)
#
# IMPORTANT: the password here must be PERCENT-ENCODED, because it sits inside
# a URL. If your password contains @ : / ? # [ ] or %, pasting it raw silently
# corrupts the URL and libpq misreads where the host begins. An unencoded "@"
# makes libpq split at the FIRST "@", so the tail of your password becomes part
# of the hostname and you get:
#
#     OperationalError: failed to resolve host '<tail-of-password>@localhost'
#
# which looks like a Docker or DNS fault and is neither. Encode it:
#
#     python -c "from urllib.parse import quote; print(quote(input(), safe=''))"
#
# @ -> %40   : -> %3A   / -> %2F   # -> %23   % -> %25
#
# POSTGRES_PASSWORD above stays RAW (Docker reads it directly, not via a URL).
# Only the copy inside DATABASE_URL is encoded, so the two lines will not look
# identical — that is correct, not a mistake.
DATABASE_URL=postgresql://marketplace:changeme_strong_password_here@localhost:5432/marketplace

# --- Orchestrator ---
PORT=8080
PROVIDER_TTL_MS=120000

# --- Provider Agent ---
PROVIDER_ID=provider-local-1
ORCHESTRATOR_URL=http://localhost:8080
REGION=us-east-1
HEARTBEAT_SEC=15
GPU_MODEL=RTX-4070
GPU_VRAM_GB=12
CPU_CORES=12
RAM_GB=32
SUPPORTS_NVENC=true
SUPPORTS_QUICKSYNC=false
SUPPORTS_GAMING=true
SUPPORTS_COMPUTE=true

# --- Local managed-inference demo ---
# Keep false outside a single-machine development environment. When enabled,
# API-key creation/revocation is allowed only from a loopback client.
LOCAL_DEMO_MODE=false
# Stable public node id printed by:
# .\agent\env\Scripts\python.exe -c "from agent.identity import node_id; print(node_id())"
DEMO_PROVIDER_NODE_ID=replace-with-local-provider-node-id
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
INFERENCE_TIMEOUT_SEC=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# --- Startup Context Server ---
# Required when serving GraphQL/MCP beyond local development.
CONTEXT_PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTEXT_API_KEY=replace-with-a-strong-random-value
