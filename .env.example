# ============================================================
# P2P Compute Marketplace — Environment Variables (Template)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. The real password must be set
# via your secret manager or local environment.
# ============================================================

# --- Database ---
POSTGRES_USER=marketplace
# REQUIRED: Set a strong password. Do NOT use the default below.
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
# Local dev URL (points to localhost; override for Docker)
#
# IMPORTANT: the password here must be PERCENT-ENCODED, because it sits inside
# a URL. If your password contains @ : / ? # [ ] or %, pasting it raw silently
# corrupts the URL and libpq misreads where the host begins. An unencoded "@"
# makes libpq split at the FIRST "@", so the tail of your password becomes part
# of the hostname and you get:
#
#     OperationalError: failed to resolve host '<tail-of-password>@localhost'
#
# which looks like a Docker or DNS fault and is neither. Encode it:
#
#     python -c "from urllib.parse import quote; print(quote(input(), safe=''))"
#
# @ -> %40   : -> %3A   / -> %2F   # -> %23   % -> %25
#
# POSTGRES_PASSWORD above stays RAW (Docker reads it directly, not via a URL).
# Only the copy inside DATABASE_URL is encoded, so the two lines will not look
# identical — that is correct, not a mistake.
DATABASE_URL=postgresql://marketplace:changeme_strong_password_here@localhost:5432/marketplace

# --- Orchestrator ---
PORT=8080
PROVIDER_TTL_MS=120000

# --- Provider Agent ---
PROVIDER_ID=provider-local-1
ORCHESTRATOR_URL=http://localhost:8080
REGION=us-east-1
HEARTBEAT_SEC=15
GPU_MODEL=RTX-4070
GPU_VRAM_GB=12
CPU_CORES=12
RAM_GB=32
SUPPORTS_NVENC=true
SUPPORTS_QUICKSYNC=false
SUPPORTS_GAMING=true
SUPPORTS_COMPUTE=true

# --- Managed inference ---
#
# LOCAL_DEMO_MODE, DEMO_PROVIDER_NODE_ID and LOCAL_OLLAMA_URL are gone.
# They configured a gateway that checked a provider was online and then ran the
# model on the orchestrator's own machine. Inference now runs on the provider's
# PC, dispatched through the job queue, so there is no local runtime to point at
# and no single node to nominate -- any online provider advertising the model is
# eligible.
#
# API-key administration is no longer gated on being loopback either. It needs a
# login (POST /v1/auth/signup), and keys belong to the account that made them.

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How long a login lasts before the user signs in again.
SESSION_TTL_DAYS=7

# How long a claimed job stays claimed before another provider may take it.
# Must exceed the slowest honest completion, cold start included: set it too low
# and a merely-slow provider has its work reassigned mid-flight, so the customer
# pays for the same answer twice.
JOB_LEASE_SEC=180

# How long an agent waits between claim attempts when there is no work. The
# claim endpoint answers immediately, so this is both the floor on how long a
# queued job waits to be picked up and the thing that stops an idle fleet from
# hammering the orchestrator. Sent to the agent, so changing it here changes the
# whole fleet without a new desktop build.
CLAIM_POLL_INTERVAL_SEC=3

# How long a customer's request waits for a provider to answer before 504.
# Keep it well above CLAIM_POLL_INTERVAL_SEC, or a request can time out before an
# idle agent has even come back to collect it.
DISPATCH_WAIT_SEC=120


# --- Startup Context Server ---
# Required when serving GraphQL/MCP beyond local development.
CONTEXT_PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTEXT_API_KEY=replace-with-a-strong-random-value
