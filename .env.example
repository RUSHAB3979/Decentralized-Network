# ============================================================
# P2P Compute Marketplace — Environment Variables (Template)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. The real password must be set
# via your secret manager or local environment.
# ============================================================

# --- Database ---
POSTGRES_USER=marketplace
# REQUIRED: Set a strong password. Do NOT use the default below.
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
# Local dev URL (points to localhost; override for Docker)
DATABASE_URL=postgresql://marketplace:changeme_strong_password_here@localhost:5432/marketplace

# --- Orchestrator ---
PORT=8080
PROVIDER_TTL_MS=120000

# --- Provider Agent ---
PROVIDER_ID=provider-local-1
ORCHESTRATOR_URL=http://localhost:8080
REGION=us-east-1
HEARTBEAT_SEC=15
GPU_MODEL=RTX-4070
GPU_VRAM_GB=12
CPU_CORES=12
RAM_GB=32
SUPPORTS_NVENC=true
SUPPORTS_QUICKSYNC=false
SUPPORTS_GAMING=true
SUPPORTS_COMPUTE=true
